{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rodar script no Blender (headless)",
            "type": "shell",
            "command": "/Applications/Blender.app/Contents/MacOS/Blender",
            "args": [
                "--background",
                "--python",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
